# ==================== ASOSIY SOZLAMALAR ====================
# Bot
BOT_TOKEN=your_bot_token_here
OWNER_ID=your_telegram_user_id
ADMIN_IDS=123456789,987654321  # Vergul bilan ajratilgan admin ID'lar

# Database
# SQLite (hozircha)
DATABASE_URL=sqlite+aiosqlite:///./database.sqlite3
# PostgreSQL (kelajakda)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/dbname

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL=3600

# Logging
LOG_FILE=bot.log
MAX_LOG_SIZE_MB=20
LOG_LEVEL=INFO

# Security
JWT_SECRET_KEY=your_super_secret_key_here
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5

# Maintenance
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Texnik ishlar olib borilmoqda...

# Rate Limiting
RATE_LIMIT_ENABLED=true
MAX_REQUESTS_PER_MINUTE=30

# File Upload
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=uploads
BACKUP_DIR=backups

# Webhook (webhook uchun)
WEBHOOK_HOST=https://your-domain.example
WEBHOOK_PATH=/webhook
WEB_SERVER_HOST=0.0.0.0
WEB_SERVER_PORT=8080
HEALTHCHECK_ENABLED=true
HEALTHCHECK_PORT=8081

# To'lovlar
# Click.uz
CLICK_MERCHANT_ID=your_merchant_id
CLICK_SERVICE_ID=your_service_id
CLICK_SECRET_KEY=your_secret_key

# Payme
PAYME_MERCHANT_ID=your_merchant_id
PAYME_SECRET_KEY=your_secret_key

# SMS Providerlar
# Eskiz.uz
ESKIZ_EMAIL=your_email
ESKIZ_PASSWORD=your_password

# PlayMobile
PLAYMOBILE_LOGIN=your_login
PLAYMOBILE_PASSWORD=your_password

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Admin Panel
ADMIN_PAGINATION_SIZE=20

# Referral
REFERRAL_LEVELS=3  # Nechta darajasigina bonus beriladi
REFERRAL_PERCENTAGES=[5, 3, 1]  # Har bir darajaga foiz